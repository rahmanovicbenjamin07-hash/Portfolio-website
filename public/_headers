# Cloudflare Workers static assets headers: https://developers.cloudflare.com/workers/static-assets/headers/

# Keep the *.workers.dev copies of the site out of search results: portfolio-website.<subdomain>.workers.dev
# and preview URLs (<version>-portfolio-website.<subdomain>.workers.dev). A placeholder matches a whole
# host label and only one splat is allowed (used by the path), so "portfolio-website" can't be spelled out
# without missing the previews. This file only applies to this Worker, so it matches nothing else.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Hashed build files (JS, CSS, fonts) never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Long cache for images and video: give a replaced file a new name.
/images/*
  Cache-Control: public, max-age=31536000

/video/*
  Cache-Control: public, max-age=31536000
